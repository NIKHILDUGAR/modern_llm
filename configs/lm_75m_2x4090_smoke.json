{
  "run_name": "lm-75m-2x4090-smoke",
  "output_dir": "experiments/runs/lm-75m-2x4090-smoke",

  "vocab_size": 16000,
  "d_model": 512,
  "n_layers": 18,
  "n_heads": 8,
  "ffn_hidden_size": 1408,
  "max_seq_len": 4096,
  "dropout": 0.0,

  "use_rope": true,
  "use_attention_sinks": false,
  "num_attention_sinks": 4,
  "use_swiglu": true,
  "tie_embeddings": true,
  "use_gqa": true,
  "gqa_groups": 2,
  "use_qk_norm": true,
  "use_moe": false,
  "scale_embeddings": true,
  "residual_init_scale": true,
  "z_loss_coef": 1e-4,
  "compile_model": true,

  "hardware_preset": "auto",
  "data_preset": "xl",
  "tokenizer_name": "tokenizers/cl_small_bpe_16k",

  "pretrain_datasets": ["wikitext-2-raw-v1"],
  "pretrain_max_steps": 50,
  "pretrain_lr": 3e-3,
  "pretrain_batch_size": 2,
  "pretrain_micro_batch_size": 1,
  "pretrain_warmup_steps": 5,

  "sft_max_steps": 4000,
  "sft_lr": 5e-5,
  "sft_batch_size": 32,
  "sft_micro_batch_size": 4,
  "sft_dataset": "allenai/tulu-3-sft-mixture",

  "dpo_max_steps": 1000,
  "dpo_lr": 3e-6,
  "dpo_batch_size": 16,
  "dpo_micro_batch_size": 2,
  "dpo_beta": 0.05,
  "dpo_dataset": "HuggingFaceH4/ultrafeedback_binarized",

  "verifier_max_steps": 2000,
  "verifier_lr": 1e-4,
  "verifier_batch_size": 32,
  "verifier_micro_batch_size": 4,

  "seed": 42,
  "mixed_precision": "bf16",
  "eval_every": 10000,
  "save_every": 10000,
  "log_every": 5
}
